[Unit]
Description=Thin Signals operator UI
Documentation=https://sourcecraft.dev/shats123/thin-signals
Wants=network-online.target
Requires=thin-signals-api.service
After=network-online.target thin-signals-api.service
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
Type=simple
User=thin-signals-ui
Group=thin-signals-ui
DynamicUser=yes
WorkingDirectory=/opt/thin-signals
Environment=TS_ROOT=/opt/thin-signals
Environment=TS_DISABLE_DOTENV=1
Environment=TS_API_URL=http://127.0.0.1:8095
Environment=TS_ACCOUNTS=%d/accounts
Environment=TS_DRAFT=/var/lib/thin-signals-ui/draft.yaml
Environment=HOME=/var/lib/thin-signals-ui
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
LoadCredential=accounts:/opt/thin-signals/.secrets/accounts.yaml
StateDirectory=thin-signals-ui
StateDirectoryMode=0700
ExecStart=/opt/thin-signals/.venv/bin/streamlit run ui/app.py --server.address 127.0.0.1 --server.port 8501 --server.headless true
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
