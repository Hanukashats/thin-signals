# Thin Signals runtime — copy to .env (gitignored). No secrets here except references to files.
TS_PROFILE=vm101                      # laptop | vm101
TS_DATABASE_URL=postgresql+psycopg://ts@127.0.0.1:55432/thin_signals
TS_PG_PASSWORD_FILE=.secrets/pg_password
TS_SNAPSHOT_DIR=snapshots
TS_RULES_VERSION=rules-0.1

# VM101 backend services (ADR 007: loopback on the same host; NetBird from laptop)
TS_SEARXNG_URL=http://127.0.0.1:28088
TS_DOCLING_URL=http://127.0.0.1:5001

# Bounded retrieval. One absolute deadline is inherited by discovery, chain and
# countersearch; individual HTTP calls never receive a longer timeout.
TS_SEARCH_MAX_WORKERS=6
TS_SEARCH_DEADLINE_SECONDS=90
TS_WIDE_SEARCH_DEADLINE_SECONDS=540
TS_SOURCE_TIMEOUT_SECONDS=40

# LLM: OpenRouter with ZDR policy (organizer-approved 2026-09-22); TZ-listed models only
TS_OPENROUTER_URL=https://openrouter.ai/api/v1
TS_OPENROUTER_KEY_FILE=.secrets/openrouter_key
TS_LLM_PRIMARY=qwen/qwen3.6-35b-a3b
TS_LLM_JUDGE=openai/gpt-5.6-luna
TS_LLM_FALLBACK=qwen/qwen3-235b-a22b-2507
TS_LLM_PROVIDER_POLICY={"zdr":true,"data_collection":"deny"}

# Evidence-gated researcher → critic → defender → control critic. Keep false
# until frozen replay + holdout gates pass; one equal budget applies per role.
TS_ADVERSARIAL_REVIEW_ENABLED=false
TS_REVIEW_TIME_SECONDS=45
TS_REVIEW_MAX_OUTPUT_TOKENS=1200
TS_REVIEW_MAX_COST_USD=0.03
TS_REVIEW_EVIDENCE_LIMIT=12
# optional: route through VM101 LiteLLM instead
TS_LITELLM_URL=http://127.0.0.1:4000/v1
TS_LITELLM_KEY_FILE=.secrets/litellm_key
TS_EMBEDDING_ALIAS=embedding-local    # TEI bge-m3
TS_PLAYWRIGHT_MCP_URL=http://127.0.0.1:8931/mcp

# Product mode refuses any LLM response whose provider is not in OpenRouter /endpoints/zdr (TZ 3.1 + organizer condition)
TS_PRODUCT_MODE=false
